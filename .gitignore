# LaTeX build artifacts
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc

# Your private applications — keep your own job applications OUT of git.
# (Remove this line if you actually want to version your applications.)
applications/*
!applications/.gitkeep
!applications/EXAMPLE/
# Tracked tailor outputs (explicit exceptions; keep other apps private)
!applications/ai-llm-product-engineer/
!applications/ai-llm-product-engineer/**
!applications/deriv/
!applications/deriv/**
!applications/frontend/
!applications/frontend/**
!applications/lenovo-ai-application-engineer/
!applications/lenovo-ai-application-engineer/**

# Your real master resume may contain personal data. If you fork this repo
# publicly, consider keeping your filled-in version private:
master-resume.tex
master-resume.pdf

# Same for the full CV: real employers, dates, and contact details.
cv.tex
cv.pdf

# Compiled output of the tracked example templates (the .tex files are tracked).
master-resume.example.pdf
cv.example.pdf

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
